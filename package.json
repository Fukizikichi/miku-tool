{
  "name": "miku-media-downloader",
  "version": "1.0.0",
  "description": "Modern Downloader built with Electron, React, Tailwind and Python",
  "main": "main.js",
  "author": "Fukizikichi",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fukizikichi/miku-tool.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "electron .",
    "dev:all": "concurrently \"npm run dev\" \"electron .\"",
    "dist:all": "npm run build && electron-builder",
    "dist:setup": "npm run build && electron-builder --win nsis",
    "dist:portable": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "lottie-react": "^2.4.0",
    "qrcode.react": "^3.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "clsx": "^2.1.1",
    "concurrently": "^8.2.2",
    "electron": "^28.1.0",
    "electron-builder": "^26.8.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.8.0",
    "postcss": "^8.4.33",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.1",
    "vite": "^5.0.11"
  }
}
